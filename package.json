{
  "name": "the-well",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "check:runtime": "node scripts/check-mobile-runtime.mjs",
    "update:runtime-lock": "node scripts/update-mobile-runtime-lock.mjs",
    "typecheck": "tsc --noEmit",
    "test:security": "node --test tests/security-contract.test.mjs tests/knowledge-base-contract.test.mjs tests/public-content-contract.test.mjs",
    "test:runtime": "playwright test",
    "test:sites": "node --test tests/sites-worker.test.mjs",
    "test:agents": "node --test tests/agent-contracts.test.mjs && node scripts/validate-agent-evals.mjs",
    "kb:embed-local": "node knowledge-base/scripts/embed-local.mjs",
    "test": "pnpm run test:security && pnpm run test:runtime",
    "predev": "node scripts/check-mobile-runtime.mjs",
    "dev": "vite",
    "prebuild": "node scripts/check-mobile-runtime.mjs",
    "build": "tsc && vite build && node scripts/prepare-sites-build.mjs"
  },
  "dependencies": {
    "@fontsource/dm-serif-display": "5.3.0",
    "@fontsource/manrope": "5.3.0",
    "@fontsource/roboto": "5.2.10",
    "@radix-ui/react-dialog": "1.1.19",
    "@radix-ui/react-dropdown-menu": "2.1.20",
    "@radix-ui/react-icons": "1.3.2",
    "@supabase/supabase-js": "2.118.0",
    "@use-gesture/react": "10.3.1",
    "motion": "12.42.2",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@huggingface/transformers": "^4.3.2",
    "@playwright/test": "1.61.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "typescript": "7.0.2",
    "vite": "8.1.3"
  }
}
